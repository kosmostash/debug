import { appendFileSync } from "node:fs";

import { tick } from "./tick.mjs";

const log = (event) => {
  appendFileSync({{logFile}}, `${event}:${tick}\n`);
};

export default {
  async start() {
    const timer = setInterval(() => {}, 1000);
    log("start");
    return async () => {
      clearInterval(timer);
      log("close");
    };
  },
};
